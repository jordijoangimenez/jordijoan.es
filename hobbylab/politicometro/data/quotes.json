   "party": "pp",
   "doc": "pp-contrato-2026",
   "page": 4,
   "item": 12,
   "text": "La Nación debe comportarse como un país serio y fiable, y recuperar las alianzas rotas en la Unión Europea e Hispanoamérica y con nuestros aliados históricos.",
   "topics": [
    "exterior"
   ],
   "subs": [
